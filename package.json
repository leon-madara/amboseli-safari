{
  "name": "amboseli-safari-club",
  "version": "0.1.0",
  "private": true,
  "description": "Luxury safari lodge website for Amboseli Safari Club",
  "author": "Amboseli Safari Club",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "clean": "node scripts/clean-cache.js",
    "clean:full": "npm run clean && npm ci",
    "rebuild": "npm run clean && npm install && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "framer-motion": "^11.0.0",
    "lenis": "^1.3.15",
    "next": "^14.2.0",
    "nodemailer": "^6.9.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "react-intersection-observer": "^10.0.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
